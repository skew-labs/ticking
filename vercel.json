{
  "rewrites": [
    {
      "source": "/api/public/engine/fast-feed",
      "destination": "/api/engine-fast-feed"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.ticking.dev/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/_app/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    },
    {
      "source": "/assets/tokens/live/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/((?!_app/|assets/).*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}
      ]
    },
    {
      "source": "/api/public/engine/fast-feed",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
