{
  "name": "@slotline/chart-sdk",
  "version": "0.2.0",
  "type": "module",
  "main": "index.js",
  "types": "types.d.ts",
  "exports": {
    "./hyperliquid": {
      "types": "./hyperliquid.d.ts",
      "default": "./hyperliquid.js"
    },
    ".": {
      "types": "./types.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./styles": {
      "types": "./chart.css.d.ts",
      "default": "./chart.css"
    },
    "./data": {
      "types": "./data.d.ts",
      "default": "./data.js"
    },
    "./solana": {
      "types": "./solana.d.ts",
      "default": "./solana.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./product": {
      "types": "./product.d.ts",
      "default": "./product.js"
    },
    "./exchange": {
      "types": "./exchange.d.ts",
      "default": "./exchange.js"
    },
    "./solana-history": {
      "types": "./solana-history.d.ts",
      "default": "./solana-history.js"
    },
    "./feed": {
      "types": "./feed.d.ts",
      "default": "./feed.js"
    }
  },
  "description": "SLOTLINE independent embed SDK. Solana market adapters, Canvas2D charts, Worker studies, editable drawings and recovery.",
  "license": "SEE LICENSE IN LICENSE.md",
  "files": [
    "*.js",
    "*.css",
    "*.d.ts",
    "README.md",
    "LICENSE.md"
  ]
}
